{
    "$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**",
            "!node_modules",
            "!.vscode",
            "!dist",
            "!out",
            "!.vitepress",
            "!.slidev",
            "!docs/.vitepress/cache",
            "!docs/.vitepress/dist",
            "!docs/public/slides",
            "!docs/public/demos",
            "!sessions/**/demo/out",
            "!sessions/**/demo/dist",
            "!sessions/**/slides/dist",
            "!bun.lock"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
		"indentWidth": 4,
        "lineWidth": 100,
        "lineEnding": "lf"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "suspicious": {
                "noExplicitAny": "warn"
            },
            "correctness": {
                "noUnusedVariables": "warn"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "asNeeded",
            "trailingCommas": "es5",
            "arrowParentheses": "asNeeded"
        }
    },
    "json": {
        "formatter": {
            "enabled": true
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
